# ==============================================================================
# TransactIQ Docker Environment Configuration Template
# Use this configuration when running the multi-container stack via Docker
# ==============================================================================

APP_NAME=TransactIQ
APP_ENV=production
APP_KEY=base64:XG8d2Lq3Z2JbYvQ5R1eP7sW9kM4nB0vA6cE8xZ1yU3w=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=info

# Database (connects to postgres container via internal bridge network)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=transactiq
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis (connects to redis container via internal bridge network)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Fintech Defaults
DEFAULT_CURRENCY=NGN
PLATFORM_FEE_BPS=150
PLATFORM_FLAT_FEE_MINOR=0
