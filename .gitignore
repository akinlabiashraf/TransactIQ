# ==============================================================================
# TransactIQ — Root Git Ignore Rules
# Protects secrets, credentials, build artifacts, and vendor caches
# ==============================================================================

# Environment files & Secrets (CRITICAL: Never commit credentials)
.env
.env.*
!.env.example
!.env.docker.example
*.env

# Backend Composer Dependencies & Laravel Storage
/backend/vendor/
/backend/storage/logs/*.log
/backend/storage/framework/cache/data/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/storage/*.key
/backend/.phpunit.result.cache
/backend/public/hot
/backend/public/storage

# Frontend Node Dependencies & Production Distribution
/frontend/node_modules/
/frontend/dist/
/frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System & IDE junk
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
